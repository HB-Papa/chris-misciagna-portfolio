---
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
---
<Base title="Not on the shelf" noindex>
  <header class="mast">
    <a class="name" href="/">{person.name}</a>
  </header>
  <main class="missing">
    <p class="num"><span>404</span><span>Not on the shelf</span></p>
    <h1>This page has been weeded, or it was never cataloged.</h1>
    <p><a class="go" href="/">Back to the collection</a></p>
  </main>
</Base>
